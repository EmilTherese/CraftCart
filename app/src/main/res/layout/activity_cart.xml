<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF3ED"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textColor="#2E1B18"
                android:textSize="32sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="My Cart"
                android:textColor="#2E1B18"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/editCart"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Edit"
                android:textColor="#B56576"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- ================= PRODUCT 1 ================= -->
        <!-- Puppy Portrait -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginTop="4dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7dp">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="80dp"
                android:src="@drawable/pup_painting"
                android:scaleType="centerCrop"
                android:contentDescription="Puppy Portrait" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Puppy Portrait"
                    android:textColor="#2E1B18"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Canvas Painting"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="₹499"
                    android:textColor="#B56576"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Quantity -->

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:background="#FDF8F4"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#2E1B18"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#555555"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Delete -->

            <TextView
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⌫"
                android:textColor="#777777"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- ================= PRODUCT 2 ================= -->
        <!-- Cute Christmas -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginTop="7dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7dp">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="80dp"
                android:src="@drawable/cute_christmas"
                android:scaleType="centerCrop"
                android:contentDescription="Cute Christmas" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cute Christmas"
                    android:textColor="#2E1B18"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Seasonal Art"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="₹399"
                    android:textColor="#B56576"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Quantity -->

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:background="#FDF8F4"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#2E1B18"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#555555"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⌫"
                android:textColor="#777777"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- ================= PRODUCT 3 ================= -->
        <!-- Flower Planters -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:layout_marginTop="7dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7dp">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="80dp"
                android:src="@drawable/flower_planters"
                android:scaleType="centerCrop"
                android:contentDescription="Flower Planters" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Flower Planters"
                    android:textColor="#2E1B18"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Home Decor"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="₹449"
                    android:textColor="#B56576"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Quantity -->

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:background="#FDF8F4"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#2E1B18"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#555555"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⌫"
                android:textColor="#777777"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- ================= PRICE DETAILS ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Price Details"
            android:textColor="#2E1B18"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- SUBTOTAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Subtotal"
                android:textColor="#666666"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹1347"
                android:textColor="#555555"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- SHIPPING -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Shipping"
                android:textColor="#666666"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹40"
                android:textColor="#555555"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5DCD7" />


        <!-- TOTAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total"
                android:textColor="#2E1B18"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹1387"
                android:textColor="#2E1B18"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- CHECKOUT -->

        <Button
            android:id="@+id/checkoutButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#B56576"
            android:text="Proceed to Checkout"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

    </LinearLayout>

</ScrollView>