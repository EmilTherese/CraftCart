<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF3ED">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TOP BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- BACK -->
                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="34sp"
                    android:textColor="#2E1B18" />

                <!-- TITLE -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Product Details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2E1B18" />

                <!-- WISHLIST -->
                <TextView
                    android:id="@+id/wishlistButton"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="♡"
                    android:textSize="30sp"
                    android:textColor="#B56576" />

                <!-- CART -->
                <TextView
                    android:id="@+id/cartButton"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🛒"
                    android:textSize="21sp" />

            </LinearLayout>


            <!-- PRODUCT IMAGE -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#FFFFFF">

                <ImageView
                    android:id="@+id/productImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/pup_painting"
                    android:scaleType="centerCrop"
                    android:contentDescription="Puppy Portrait" />

                <!-- IMAGE HEART -->
                <TextView
                    android:id="@+id/imageWishlistButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:text="♡"
                    android:textSize="28sp"
                    android:textColor="#FFFFFF" />

            </FrameLayout>


            <!-- PRODUCT INFORMATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- PRODUCT NAME -->
                <TextView
                    android:id="@+id/productName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Puppy Portrait"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#2E1B18" />

                <!-- CATEGORY -->
                <TextView
                    android:id="@+id/productCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Canvas Painting"
                    android:textSize="14sp"
                    android:textColor="#777777" />

                <!-- PRICE -->
                <TextView
                    android:id="@+id/productPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="₹499"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#B56576" />


                <!-- RATING -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ratingStars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★★★★★"
                        android:textSize="17sp"
                        android:textColor="#D69B42" />

                    <TextView
                        android:id="@+id/ratingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="4.8 (32 reviews)"
                        android:textSize="13sp"
                        android:textColor="#777777" />

                </LinearLayout>


                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#E8DCD6" />


                <!-- DESCRIPTION TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="About this product"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2E1B18" />

                <!-- DESCRIPTION -->
                <TextView
                    android:id="@+id/productDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="A beautiful handmade painting created with care and attention to detail. This charming artwork is perfect for adding a warm and artistic touch to your room or gifting it to someone special."
                    android:textSize="14sp"
                    android:textColor="#666666" />


                <!-- PRODUCT DETAILS TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Product Details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2E1B18" />


                <!-- DETAILS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Handmade artwork"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Canvas painting"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Carefully crafted"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Perfect for gifting"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                </LinearLayout>


                <!-- QUANTITY -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Quantity"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#2E1B18" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="#FFFFFF">

                    <TextView
                        android:id="@+id/decreaseQuantity"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="−"
                        android:textSize="22sp"
                        android:textColor="#555555" />

                    <TextView
                        android:id="@+id/quantityText"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2E1B18" />

                    <TextView
                        android:id="@+id/increaseQuantity"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:text="+"
                        android:textSize="22sp"
                        android:textColor="#555555" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM ACTION BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="12dp">

        <!-- ADD TO CART -->
        <Button
            android:id="@+id/addToCartButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Add to Cart"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B56576" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <!-- BUY NOW -->
        <Button
            android:id="@+id/buyNowButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Buy Now"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#B56576"
            android:backgroundTint="#FDF3ED" />

    </LinearLayout>

</FrameLayout>