<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDF3ED">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/backButton"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#2E1B18"
                    android:textSize="32sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="My Wishlist"
                    android:textColor="#2E1B18"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="♡"
                    android:textColor="#B56576"
                    android:textSize="25sp" />

            </LinearLayout>


            <!-- WISHLIST ITEM 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="92dp"
                    android:src="@drawable/puppy_painting"
                    android:scaleType="centerCrop"
                    android:contentDescription="Puppy Dreams" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Puppy Dreams"
                        android:textColor="#2E1B18"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Canvas Painting"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="₹499"
                        android:textColor="#2E1B18"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="-2dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Move to Cart"
                        android:textColor="#B56576"
                        android:textSize="10sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="⌫"
                    android:textColor="#555555"
                    android:textSize="17sp" />

            </LinearLayout>


            <!-- WISHLIST ITEM 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="7dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="92dp"
                    android:src="@drawable/miffy_keychai"
                    android:scaleType="centerCrop"
                    android:contentDescription="Miffy Keychain" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Miffy Keychain"
                        android:textColor="#2E1B18"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Acrylic Keychain"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="₹349"
                        android:textColor="#2E1B18"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="-2dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Move to Cart"
                        android:textColor="#B56576"
                        android:textSize="10sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="⌫"
                    android:textColor="#555555"
                    android:textSize="17sp" />

            </LinearLayout>


            <!-- WISHLIST ITEM 3 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="7dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="92dp"
                    android:src="@drawable/flower_planters"
                    android:scaleType="centerCrop"
                    android:contentDescription="Flower Planters" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="92dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Flower Planters"
                        android:textColor="#2E1B18"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Home Decor"
                        android:textColor="#888888"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="₹449"
                        android:textColor="#2E1B18"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="-2dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="Move to Cart"
                        android:textColor="#B56576"
                        android:textSize="10sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="⌫"
                    android:textColor="#555555"
                    android:textSize="17sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM NAVIGATION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal">


        <!-- HOME -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="⌂"
                android:textColor="#555555"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#555555"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- CATEGORIES -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="▦"
                android:textColor="#555555"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textColor="#555555"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- ORDERS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="▣"
                android:textColor="#555555"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orders"
                android:textColor="#555555"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- WISHLIST SELECTED -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="&#x2665;&#xFE0E;"
                android:textColor="#B56576"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wishlist"
                android:textColor="#B56576"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="♙"
                android:textColor="#555555"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#555555"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>