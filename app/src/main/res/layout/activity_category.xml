<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF3ED">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textSize="38sp"
                android:textColor="#2E1B18" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Categories"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2E1B18" />

            <TextView
                android:id="@+id/cartButton"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🛒"
                android:textSize="21sp" />

        </LinearLayout>


        <!-- CATEGORY CONTENT -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="20dp">


                <!-- SEARCH -->

                <EditText
                    android:id="@+id/categorySearch"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#FFFFFF"
                    android:hint="Search categories..."
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textSize="14sp"
                    android:textColor="#2E1B18"
                    android:textColorHint="#999999" />


                <!-- TITLE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Explore Categories"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2E1B18" />


                <!-- ROW 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- PAINTINGS -->

                    <LinearLayout
                        android:id="@+id/paintingsCategory"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:gravity="center"
                            android:text="🎨"
                            android:textSize="55sp"
                            android:background="#FAF0EA" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:text="Paintings"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2E1B18" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="3dp"
                            android:text="120+ items"
                            android:textSize="12sp"
                            android:textColor="#777777" />

                    </LinearLayout>


                    <!-- HANDMADE GIFTS -->

                    <LinearLayout
                        android:id="@+id/giftsCategory"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:gravity="center"
                            android:text="🎁"
                            android:textSize="55sp"
                            android:background="#FAF0EA" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:text="Handmade Gifts"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2E1B18" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="3dp"
                            android:text="95+ items"
                            android:textSize="12sp"
                            android:textColor="#777777" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ROW 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- KEYCHAINS -->

                    <LinearLayout
                        android:id="@+id/keychainsCategory"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:gravity="center"
                            android:text="🔑"
                            android:textSize="55sp"
                            android:background="#FAF0EA" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:text="Keychains"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2E1B18" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="3dp"
                            android:text="80+ items"
                            android:textSize="12sp"
                            android:textColor="#777777" />

                    </LinearLayout>


                    <!-- LETTERS -->

                    <LinearLayout
                        android:id="@+id/lettersCategory"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:gravity="center"
                            android:text="✉"
                            android:textSize="55sp"
                            android:textColor="#B56576"
                            android:background="#FAF0EA" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:text="Handwritten Letters"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2E1B18" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="3dp"
                            android:text="60+ items"
                            android:textSize="12sp"
                            android:textColor="#777777" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ROW 3 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- HOME DECOR -->

                    <LinearLayout
                        android:id="@+id/homeDecorCategory"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:gravity="center"
                            android:text="🪴"
                            android:textSize="55sp"
                            android:background="#FAF0EA" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:text="Home Decor"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2E1B18" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="3dp"
                            android:text="70+ items"
                            android:textSize="12sp"
                            android:textColor="#777777" />

                    </LinearLayout>


                    <!-- CROCHET -->

                    <LinearLayout
                        android:id="@+id/crochetCategory"
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="#FFFFFF"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="125dp"
                            android:gravity="center"
                            android:text="🧶"
                            android:textSize="55sp"
                            android:background="#FAF0EA" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:text="Crochet &amp; Knit"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#2E1B18" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="3dp"
                            android:text="85+ items"
                            android:textSize="12sp"
                            android:textColor="#777777" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>


        <!-- BOTTOM NAVIGATION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="horizontal"
            android:elevation="8dp">


            <!-- HOME -->

            <LinearLayout
                android:id="@+id/homeNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌂"
                    android:textSize="25sp"
                    android:textColor="#555555" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="11sp"
                    android:textColor="#555555" />

            </LinearLayout>


            <!-- CATEGORIES -->

            <LinearLayout
                android:id="@+id/categoriesNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▦"
                    android:textSize="25sp"
                    android:textColor="#B56576" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categories"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B56576" />

            </LinearLayout>


            <!-- ORDERS -->

            <LinearLayout
                android:id="@+id/ordersNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textSize="23sp"
                    android:textColor="#555555" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orders"
                    android:textSize="11sp"
                    android:textColor="#555555" />

            </LinearLayout>


            <!-- WISHLIST -->

            <LinearLayout
                android:id="@+id/wishlistNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♡"
                    android:textSize="28sp"
                    android:textColor="#555555" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wishlist"
                    android:textSize="11sp"
                    android:textColor="#555555" />

            </LinearLayout>


            <!-- PROFILE -->

            <LinearLayout
                android:id="@+id/profileNav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♙"
                    android:textSize="25sp"
                    android:textColor="#555555" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="11sp"
                    android:textColor="#555555" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>